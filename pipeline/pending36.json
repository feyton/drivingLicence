[{"_id":"6a91f76c50eec2e053fabb04","text":"<p>Iyo umuvuduko w'ibinyabiziga bidapakiye udashobora kurenga 50km mu isaha ahategamye ibikoresho by'ihoni byumvikanira ku ntera ya</p>","options":[{"id":"A","text":"150m"},{"id":"B","text":"100m"},{"id":"C","text":"50m"},{"id":"D","text":"20m"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28","importSource":{"file":"Copy (2) Of Excorection.pdf","page":36,"answerSource":"inline","mergedFrom":["Excorectionnw1.pdf","Exercise.pdf","Ibibazo N_Ibisubizo.docx"],"aiResolved":false,"aiResolution":null},"verification":{"at":"2026-08-28T21:53:45.398Z","confidence":"medium","reason":"Isoko y'ikoranyabuhanga (rwandatrafficguide.com, ikibazo gisa n'iki) yerekana ko igisubizo cy'ukuri ari metero 100 (B) aho kuba metero 50 (C).","status":"needs-review","suggestedAnswer":"B","verdict":"wrong"}},{"_id":"6a91f76c50eec2e053fabb6a","text":"<p>Hagati y'imodoka ziherekeranije mu butumwa zigamije urugendo rumwe hagomba kuba byibura</p>","options":[{"id":"A","text":"50m"},{"id":"B","text":"40m"},{"id":"C","text":"30m"},{"id":"D","text":"20m"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28","importSource":{"file":"Copy (2) Of Excorection.pdf","page":20,"answerSource":"inline","mergedFrom":["Excorectionnw1.pdf","Exercise.pdf","Ibibazo N_Ibisubizo.docx"],"aiResolved":false,"aiResolution":null},"verification":{"at":"2026-08-28T21:53:45.398Z","confidence":"medium","reason":"Analogous convoy-spacing rules (French/Belgian model this code follows) set this distance at 50m outside built-up areas, not 30m.","status":"needs-review","suggestedAnswer":"A","verdict":"wrong"}},{"_id":"6a91f76c50eec2e053fabba6","text":"<p>Amatara maremare y'ikinyabiziga agomba kutamurika mu bihe bikurikira:</p>","options":[{"id":"A","text":"iyo umuhanda umurikiwe umuyobozi abasha kureba muri m 200"},{"id":"B","text":"iyo ikinyabiziga kigiye kubisikana nikindi"},{"id":"C","text":"iyo ari mu nsisiro"},{"id":"D","text":"ibisubizo byose nibyo"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28","importSource":{"file":"DL Questions.pdf","page":34,"answerSource":"inline","mergedFrom":[],"aiResolved":false,"aiResolution":null},"verification":{"at":"2026-08-28T21:53:45.398Z","confidence":"medium","reason":"A, B na C zose ni impamvu zemewe zo kutamurika amatara maremare, bityo 'byose nibyo' (D) isa n'ibisubizo bynyayo, atari B honyine.","status":"needs-review","suggestedAnswer":"D","verdict":"wrong"}},{"_id":"6a92c0749dfaa1c9fe7eeb52","text":"<p>Amatara kamera bihu y'inyuma ntashobora gukoreshwa keretse hari inkomyi zo kutabona neza (imiterere y'ikirere igize ko kubona neza bigoye, nk'igihu cyangwa imvura nyinshi bituma ntawe ubona hirya) ya:</p>","options":[{"id":"A","text":"m150"},{"id":"B","text":"m100"},{"id":"C","text":"m50"},{"id":"D","text":"Nta gisubizo cy'ukuri kirimo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":67,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb5b","text":"<p>Abakuru b'intara n'abayobozi b'uturere bashobora kugena, ahandi hantu hose hashobora gufungirwa ibinyabiziga kandi hakarindwa. Ubusanzwe ahagenewe gufungirwa ibinyabiziga ni za parikingi zemejwe na:</p>","options":[{"id":"A","text":"Minisitiri w'ubutabera"},{"id":"B","text":"Minisitiri wo gutwara abantu n'ibintu"},{"id":"C","text":"Ntagisubizo cy'ukuri kirimo"},{"id":"D","text":"Porokireri wa Repubulika"},{"id":"E","text":"Polisi y'igihugu"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":46,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb5c","text":"<p>Umuyobozi w'ikinyabiziga gikurikira ikindi, agomba gusiga umwanya uhagije hagati y'ikinyabiziga cye n'icyo akurikiye kugira ngo:</p>","options":[{"id":"A","text":"Abagenzi bamuhagaritse babashe kunyuranamo bibaye ngombwa"},{"id":"B","text":"Atakigonga mu gihe kigabanyije umuvuduko"},{"id":"C","text":"Atakigonga mu gihe kigabanyije umuvuduko ku buryo butunguranye"},{"id":"D","text":"A,B,C byose ni ibisubizo by'ukuri"},{"id":"E","text":"B na C ni byo bisubizo by'ukuri"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":56,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb5d","text":"<p>Bitabujije ububasha abagenzacyaha bahabwa n'amategeko, abashinzwe kubahiriza iri teka cyane ni:</p>","options":[{"id":"A","text":"Abapolisi bose bo muri polisi y'igihugu"},{"id":"B","text":"Igihe bari mu kazi"},{"id":"C","text":"Ba ofisiye na ba suzofisiye bose bo mu ngabo z'igihugu"},{"id":"D","text":"Abakozi bo mu biro bya minisitiri w'imirimo ya Leta babihereye ububasha na minisitiri w'ubutabera"},{"id":"E","text":"Abakozi bo mu biro bya minisitiri wo gutwara abantu n'ibintu babihereye ububasha na minisitiri w'ubutabera"},{"id":"F","text":"A,B,C na D byose ni ibisubizo by'ukuri"}],"answer":"F","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":58,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb5e","text":"<p>Iyo ibinyabiziga bigomba kubisikana ari byo mu rwego rumwe, ugomba gusubira inyuma ni:</p>","options":[{"id":"A","text":"Umuyobozi w'ikinyabiziga gito ahuye n'ikinini"},{"id":"B","text":"Umuyobozi w'ikinyabiziga kidakomatanye ahuye n'igikomatanye"},{"id":"C","text":"Umuyobozi w'ikinyabiziga gitwara imizigo ahuye n'igitwara abantu hamwe"},{"id":"D","text":"Umuyobozi w'ikinyabiziga kimanuka"},{"id":"E","text":"Byose ni byo"},{"id":"F","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"E","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":50,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb5f","text":"<p>Amatara maremare, amatara magufi, amatara kamenabihu, amatara ndangambere, n'itara ribonesha icyapa kiranga ikinyabiziga, ashobora gukoreshwa gusa mu gihe:</p>","options":[{"id":"A","text":"Amatara ndanga ari ku mpera z'ikinyabiziga gikurura na yo yaka"},{"id":"B","text":"Amatara ndanga ari ku mpera y'ikinyabiziga cya nyuma mu bikomatanye na yo yaka"},{"id":"C","text":"A na B byombi ni ibisubizo by'ukuri"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":60,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb6e","text":"<p>Bitabangamiye ububasha abagenzacyaha bahabwa n'amategeko, umugenzi wese uguweho n'impanuka agomba:</p>","options":[{"id":"A","text":"Guhita ahagarara uko byagenda kose"},{"id":"B","text":"Gukora uko ashoboye kugirango uburyo bwo kugenda mu muhanda aho impanuka yabereye buhungabane"},{"id":"C","text":"Gushyira ibimenyetso mu muhanda"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":52,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb6f","text":"<p>Iyo banyuze iruhande rw'inkomyi abanyamaguru bagomba gukikira banyuze mu muhanda, abayobozi bagomba gusiga umwanya ufite ubugari bwa:</p>","options":[{"id":"A","text":"2m hagati yabo niyo nkomyi"},{"id":"B","text":"1m imbere yabo niyo nkomyi"},{"id":"C","text":"1m inyuma yabo niyo nkomyi"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":47,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb70","text":"<p>Buri kinyamitende itatu cyangwa ine, vélo-moteri, na pikipiki, bigomba kugira ibyuma byo guhagarara, bikwiye gufunga nibura:</p>","options":[{"id":"A","text":"Inziga z'inyuma"},{"id":"B","text":"Izindi nziga z'imbere"},{"id":"C","text":"A na B byombi ni ibisubizo by'ukuri"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":57,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb71","text":"<p>Ibiziga by'ikinyabiziga bigendeshwa na moteri, iby'ivelo-moteri, na romoroki zikuruwe nabyo, bigomba kuba byambaye inziga:</p>","options":[{"id":"A","text":"Zikozwe mu byuma"},{"id":"B","text":"Zikozwe muri kawucu"},{"id":"C","text":"Zinjyamo umwuka ariko zihagwa"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":49,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb72","text":"<p>Kugira ngo habeho umutekano mu muhanda, umukuru w'intara ashobora, mu ifasi ashinzwe, gutegeka ko mu mihanda avuze haba:</p>","options":[{"id":"A","text":"Ibyerekezo bibiri"},{"id":"B","text":"Icyerekezo kimwe"},{"id":"C","text":"Ibyerekezo byombi"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":61,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb73","text":"<p>Kunyuranaho bikorerwa mu ruhande:</p>","options":[{"id":"A","text":"Rw'ibumoso gusa"},{"id":"B","text":"Rw'iburyo gusa"},{"id":"C","text":"Bishobora gukorerwa mu ruhande rw'iburyo"},{"id":"D","text":"A,B,C na D byose ni ibisubizo by'ukuri"},{"id":"E","text":"C na D ni byo bisubizo by'ukuri"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":59,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb74","text":"<p>Imodoka zo mu rwego rwa C ni imodoka zagenewe gutwara ibintu bifite uburemere ntarengwa bwemewe burenga:</p>","options":[{"id":"A","text":"Kg750"},{"id":"B","text":"Kg2500"},{"id":"C","text":"Kg5000"},{"id":"D","text":"Nta gisubizo cy'ukuri kirimo"}],"answer":"D","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":64,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb75","text":"<p>Inziga zishobora gushyirwaho iminyururu irwanya ubunyereri, ibyo bigakorwa kugira ngo ikinyabiziga:</p>","options":[{"id":"A","text":"Kigende neza"},{"id":"B","text":"Kive mu byondo"},{"id":"C","text":"Kive ahantu habi cyaheze"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":55,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb85","text":"<p>Ibice by'umuhanda byera bigari biteganye n'umurongo ugabanya umuhanda mo ,kabiri bisobanura:</p>","options":[{"id":"A","text":"guhagara kw'ikinyabiziga"},{"id":"B","text":"aho abanyamaguru bambukira"},{"id":"C","text":"guha  ubushobozi  binyabiziga"},{"id":"D","text":"ibisubizo byose ni ukuri"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"DL Questions.pdf","page":90,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb86","text":"<p>Igihe ibyangombwa by'ingenzi bicitse, ikizirikisho cyo gutabara gikoreshwa gusa:</p>","options":[{"id":"A","text":"Kugira ngo ikinyabiziga gikururwa kigende neza"},{"id":"B","text":"Kugira ngo ikinyabiziga kigere aho kigomba gukorerwa"},{"id":"C","text":"Kugira ngo hataba impanuka"},{"id":"D","text":"A,B,C byose ni ibisubizo by'ukuri"}],"answer":"B","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":60,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb87","text":"<p>Umuyobozi agomba gukora uko ashoboye kugira ngo yirinde kwangiza umuhanda:</p>","options":[{"id":"A","text":"Anyura indi nzira"},{"id":"B","text":"Agabanya ibyo yikoreye"},{"id":"C","text":"Agenda gahoro"},{"id":"D","text":"Byose ni byo"}],"answer":"D","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":66,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb88","text":"<p>Gukoresha ingenzura ry'itegeko, igenzura rigomba gutangira nyuma y'imyaka:</p>","options":[{"id":"A","text":"Imyaka 2 nyuma yo gushyirwa mu muhanda"},{"id":"B","text":"Imyaka 3 nyuma yo gushyirwa mu muhanda"},{"id":"C","text":"Umwaka 1 nyuma yo gushyirwa mu muhanda"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":46,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb8a","text":"<p>Iyo begereye ibyome, abayobozi bagomba gutondekanya imirongo:</p>","options":[{"id":"A","text":"Iburyo bw'umuhanda"},{"id":"B","text":"Ibumoso"},{"id":"C","text":"Iburyo n'ibumoso"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":52,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb8b","text":"<p>Bavuga ko ikinyabiziga kiri mu igerageza iyo:</p>","options":[{"id":"A","text":"Kiri mu igaraje"},{"id":"B","text":"Kiri muri kaburimbo bakumva uko bigenda"},{"id":"C","text":"Kigendeshwa n'abagikoze, abakiguze, abacyongeyeho karisoro, abakigurisha n'abongera kukigurisha"},{"id":"D","text":"Ntagisubizo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu6 Worked on.docx","page":68,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb99","text":"<p>Imyaka yifatizo ku bayobozi b'amagare ni:</p>","options":[{"id":"A","text":"Imyaka 18"},{"id":"B","text":"Imyaka 20"},{"id":"C","text":"Imyaka 15"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"D","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":48,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9a","text":"<p>Kubisikana no kubinyuranamo biba:</p>","options":[{"id":"A","text":"Iyo hari ibinyabiziga mu muhanda"},{"id":"B","text":"Iyo rimwe na rimwe imodoka ifite umuvuduko mwinshi"},{"id":"C","text":"Iyo ibinyabiziga bigenda"},{"id":"D","text":"Nta gisubizo kiricyo"}],"answer":"C","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu6 Worked on.docx","page":28,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9e","text":"<p>Ikinyabiziga kibujijwe guhagarara akanya kanini:</p>","options":[{"id":"A","text":"Hejuru no munsi y'amateme, no ku mihanda inyura ikuzimu"},{"id":"B","text":"Ahatageza muri m2 nibura hino y'ikimenyetso cy'umuriro cyerekana uburyo bwo kugenda mu muhanda"},{"id":"C","text":"Iyo ubugari bw'umwanya usigaye ku muhanda butaba bufite m3"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":61,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeba0","text":"<p>Ibinyabiziga bidasanzwe bigomba gutwarwa nibura n'umuyobozi ufite imyaka 18.</p>","options":[{"id":"A","text":"Yego"},{"id":"B","text":"Oya"}],"answer":"A","category":"general","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu6 Worked on.docx","page":45,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a91f76c50eec2e053fabb45","text":"<p>Ahanyura abayobozi b'amagare na velomoteri zifite imitende ibiri bambukiranya umuhanda hagaragazwa na</p>","options":[{"id":"A","text":"Imirongo ibiri icagaguye igizwe na kare z'ibara ry'umweru"},{"id":"B","text":"Imirongo ibiri icagaguye igizwe n'ingirwamwashi z'ibara ry'umweru"},{"id":"C","text":"A na B ni ibisubizo by'ukuri"},{"id":"D","text":"Nta gisubizo cy'ukuri kirimo"}],"answer":"C","category":"posts","importBatch":"corpus-2026-08-28","importSource":{"file":"Copy (2) Of Excorection.pdf","page":43,"answerSource":"inline","mergedFrom":["Excorectionnw1.pdf","Exercise.pdf","Ibibazo N_Ibisubizo.docx"],"aiResolved":false,"aiResolution":null},"verification":{"at":"2026-08-28T21:53:45.398Z","confidence":"medium","reason":"Cyclist-crossing markings are internationally defined as two dashed lines of white squares only; lozenge shapes aren't part of that marking, so 'A and B' is unlikely correct.","status":"needs-review","suggestedAnswer":"A","verdict":"wrong"}},{"_id":"6a91f76c50eec2e053fabc08","text":"<p>Ibyapa biyobora bishyirwa ahantu haboneye kurushaho hakurijwe</p>","options":[{"id":"A","text":"Uko icyo byerekana kimeze"},{"id":"B","text":"Aho birushijeho kubonwa neza"},{"id":"C","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"A","category":"posts","importBatch":"corpus-2026-08-28","importSource":{"file":"Copy (2) Of Excorection.pdf","page":45,"answerSource":"inline","mergedFrom":["Excorectionnw1.pdf","Exercise.pdf","Ibibazo N_Ibisubizo.docx"],"aiResolved":false,"aiResolution":null},"verification":{"at":"2026-08-28T21:53:45.398Z","confidence":"medium","reason":"Ibyapa bishyirwa ahagaragara neza (visibility), ntabwo ari uko icyo byerekana kimeze","status":"needs-review","suggestedAnswer":"B","verdict":"wrong"}},{"_id":"6a92c0749dfaa1c9fe7eeb60","text":"<p>Ibyapa byo ku muhanda bigomba gushyirwa ku ruhande rw'iburyo bw'umuhanda, ku buryo umuzuzo wohasi udashobora kuba munsi ya m1,80 cyangwa hejuru ya m zingahe, uvuye ku butaka:</p>","options":[{"id":"A","text":"m1,50"},{"id":"B","text":"m2,10"},{"id":"C","text":"m2,50"},{"id":"D","text":"m1,80"},{"id":"E","text":"m10"},{"id":"F","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"B","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":54,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb61","text":"<p>Ikinyabiziga cyanyuma mu binyabiziga biherekeranyijwe mu butumwa cyigomba gushyirwaho inyuma icyapa cy'umuhondo cyanditseho mu nyuguti zitukura \"FIN DE CONVOI\", aya magambo akaba agomba gusomeka no kumanywa muri:</p>","options":[{"id":"A","text":"50m"},{"id":"B","text":"150m"},{"id":"C","text":"100m"},{"id":"D","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"C","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":48,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb89","text":"<p>Uburemere ntarengwa bwemewe bujya mu cyome bwerekanwa n'ibyapa:</p>","options":[{"id":"A","text":"Biri ku mpera zose"},{"id":"B","text":"Biri ku mpera y'icyome"},{"id":"C","text":"Biri ku ntangiriro y'icyome"},{"id":"D","text":"Nta gisubizo cy'ukuri kirimo"}],"answer":"C","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":67,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9b","text":"<p>Aho ibinyabiziga bigenda ku mirongo ibangikanye, ugutambukira iburyo abayobozi bagenda ku murongo w'ibumoso:</p>","options":[{"id":"A","text":"Bifatwa nk'inyuranaho risobanurwa n'iri teka"},{"id":"B","text":"Ntibifatwa nk'inyuranaho risobanurwa n'iri teka"},{"id":"C","text":"Ntagisubizo cy'ukuri kirimo"}],"answer":"B","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":52,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9c","text":"<p>Ibimenyetso by'agateganyo:</p>","options":[{"id":"A","text":"Bigabanya agaciro n'ibimenyetso birombereje biri mu muhanda"},{"id":"B","text":"Byubahirizwa iyo ntabindi bimenyetso biri mu muhanda"},{"id":"C","text":"Birusha agaciro cyangwa bivanaho agaciro k'ibimenyetso byera biri ahantu hamwe"},{"id":"D","text":"Nta gisubizo"}],"answer":"C","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu6 Worked on.docx","page":6,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9d","text":"<p>Ahatari mu nsisiro, ibyapa biburira bishobora gushyirwa mu ntera:</p>","options":[{"id":"A","text":"Kuva kuri m100 kugeza kuri m200"},{"id":"B","text":"Kuva kuri m150 kugeza kuri m200"},{"id":"C","text":"A na B byombi ni byo"}],"answer":"B","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu 8.pdf","page":57,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}},{"_id":"6a92c0749dfaa1c9fe7eeb9f","text":"<p>Ibitegetswe n'abakozi babifitiye ububasha binganya agaciro n'ibindi bimenyetso byose.</p>","options":[{"id":"A","text":"Yego"},{"id":"B","text":"Oya"}],"answer":"B","category":"posts","importBatch":"corpus-2026-08-28-resolved","importSource":{"file":"Gugu6 Worked on.docx","page":43,"answerSource":"ai-resolved","mergedFrom":[],"aiResolved":true,"aiResolution":{"confidence":"medium"}}}]